{
  "manifest_version": 3,
  "name": "Print Cleaner for VRChat",
  "short_name": "Print Cleaner",
  "version": "1.0.5",
  "description": "VRChatのプリントが上限に達したら、保護(★)していない古いものから自動削除します。非公式ツールです。",
  "permissions": ["storage", "alarms", "scripting", "webRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://vrchat.com/*",
    "https://*.vrchat.cloud/*",
    "https://assets.vrchat.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Print Cleaner for VRChat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "manager.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
